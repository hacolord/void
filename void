local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer or Players.LocalPlayer:GetPropertyChangedSignal("LocalPlayer"):Wait()

if not _G.HubState then _G.HubState = {} end
if not _G.HubLogic then _G.HubLogic = {} end

_G.HubState.fullSaveFileName = "FullGui_Save.json"
_G.HubState.isAttached = false
_G.HubState.targetModeIndex = 3
_G.HubState.mode1Name = "Hủy"
_G.HubState.mode2Name = "Hủy"
_G.HubState.studOffset = 0
_G.HubState.attachDuration = 0

_G.HubState.isMiniVoidVisible = true
_G.HubState.isMiniKBVisible = true

_G.HubState.trackedVoidY = workspace.FallenPartsDestroyHeight
_G.HubState.recordedVoidY = workspace.FallenPartsDestroyHeight
_G.HubState.lastSafeY = 0
_G.HubState.killBricksList = {}

_G.HubState.originalCFrame = nil
_G.HubState.attachTimerThread = nil
_G.HubState.currentAnchorPart = nil
_G.HubState.currentWeldConstraint = nil
_G.HubState.heartbeatConnection = nil

-- Trạng thái Anti Void (Mặc định bật)
_G.HubState.isAntiVoidEnabled = _G.HubState.isAntiVoidEnabled ~= nil and _G.HubState.isAntiVoidEnabled or true
_G.HubState.originalFallenHeight = _G.HubState.originalFallenHeight or workspace.FallenPartsDestroyHeight

local function blockVoidDeath(character)
    local humanoid = character:WaitForChild("Humanoid", 10)
    
    if humanoid then
        if _G.HubState.isAntiVoidEnabled then
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
            humanoid.BreakJointsOnDeath = false
            pcall(function()
                workspace.FallenPartsDestroyHeight = -99999999
            end)
        else
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
            humanoid.BreakJointsOnDeath = true
            pcall(function()
                workspace.FallenPartsDestroyHeight = _G.HubState.originalFallenHeight or -500
            end)
        end
    end
end

_G.HubLogic.ToggleAntiVoid = function(enabled)
    _G.HubState.isAntiVoidEnabled = enabled
    local char = localPlayer.Character
    if char then
        blockVoidDeath(char)
    end
end

if localPlayer.Character then
    blockVoidDeath(localPlayer.Character)
end

localPlayer.CharacterAdded:Connect(blockVoidDeath)

_G.HubLogic.SyncMiniGuiStates = function()
    local w = _G.HubState.Widgets
    if not w then return end

    if _G.HubState.targetModeIndex == 1 and _G.HubState.isAttached then
        w.voidBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        w.voidBtn.Text = "VOID\nON"
        w.kbBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
        w.kbBtn.Text = "KB\nOFF"
    elseif _G.HubState.targetModeIndex == 2 and _G.HubState.isAttached then
        w.kbBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        w.kbBtn.Text = "KB\nON"
        w.voidBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
        w.voidBtn.Text = "VOID\nOFF"
    else
        w.voidBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
        w.voidBtn.Text = "VOID\nOFF"
        w.kbBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
        w.kbBtn.Text = "KB\nOFF"
    end
end

local function getNearestKillBrick()
    local char = localPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local pos = char.HumanoidRootPart.Position
    local nearest, minDistance = nil, math.huge
    for _, kb in ipairs(_G.HubState.killBricksList) do
        if kb and kb.Parent then
            local dist = (kb.Position - pos).Magnitude
            if dist < minDistance then
                minDistance = dist
                nearest = kb
            end
        end
    end
    return nearest
end

local function getTargetRotation()
    local yaw, pitch = 0, 0
    local m1 = _G.HubState.mode1Name
    local m2 = _G.HubState.mode2Name

    if m1 == "Trước" then yaw = 0 
    elseif m1 == "Phải" then yaw = math.rad(-90) 
    elseif m1 == "Sau" then yaw = math.rad(180) 
    elseif m1 == "Trái" then yaw = math.rad(90) 
    end

    if m2 == "Dưới đất" then pitch = math.rad(-90) 
    elseif m2 == "Lên trời" then pitch = math.rad(90) 
    end

    return CFrame.Angles(pitch, yaw, 0)
end

local function stopHeartbeatLoop()
    if _G.HubState.heartbeatConnection then
        _G.HubState.heartbeatConnection:Disconnect()
        _G.HubState.heartbeatConnection = nil
    end
end

-- Cập nhật logic dịch chuyển CẢ CƠ THỂ sang Void hỗ trợ Model custom
_G.HubLogic.UpdateAttachment = function()
    local char = localPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart

    if _G.HubState.attachTimerThread then
        task.cancel(_G.HubState.attachTimerThread)
        _G.HubState.attachTimerThread = nil
    end

    stopHeartbeatLoop()

    if _G.HubState.isAttached and (_G.HubState.targetModeIndex == 1 or _G.HubState.targetModeIndex == 2) then
        if _G.HubState.currentWeldConstraint then
            _G.HubState.currentWeldConstraint:Destroy()
            _G.HubState.currentWeldConstraint = nil
        end
        if _G.HubState.currentAnchorPart then
            _G.HubState.currentAnchorPart:Destroy()
            _G.HubState.currentAnchorPart = nil
        end

        if not _G.HubState.originalCFrame then
            _G.HubState.originalCFrame = char:GetPivot()
        end

        local rotCFrame = getTargetRotation()

        local anchor = Instance.new("Part")
        anchor.Name = "OneShotPhysicalAnchor"
        anchor.Size = Vector3.new(1, 1, 1)
        anchor.Transparency = 1
        anchor.CanCollide = false
        anchor.Anchored = true
        anchor.Parent = workspace
        _G.HubState.currentAnchorPart = anchor

        local weld = Instance.new("WeldConstraint")
        weld.Name = "OneShotPhysicalWeld"
        weld.Part0 = anchor
        weld.Part1 = hrp
        weld.Parent = anchor
        _G.HubState.currentWeldConstraint = weld

        _G.HubState.heartbeatConnection = game:GetService("RunService").Heartbeat:Connect(function()
            local currentChar = localPlayer.Character
            if not currentChar or not currentChar:FindFirstChild("HumanoidRootPart") then return end

            local currentHrp = currentChar.HumanoidRootPart
            local targetPos = Vector3.new(0, 0, 0)
            local pos = currentHrp.Position

            if _G.HubState.targetModeIndex == 1 then
                local voidBaseY = _G.HubState.recordedVoidY
                if voidBaseY >= -50 then
                    voidBaseY = workspace.FallenPartsDestroyHeight - 15
                end
                targetPos = Vector3.new(pos.X, voidBaseY + _G.HubState.studOffset, pos.Z)
            elseif _G.HubState.targetModeIndex == 2 then
                local nearestKB = getNearestKillBrick()
                if nearestKB then
                    targetPos = nearestKB.Position + Vector3.new(0, _G.HubState.studOffset, 0)
                else
                    targetPos = pos
                end
            end

            local finalCFrame = CFrame.new(targetPos) * rotCFrame
            if _G.HubState.currentAnchorPart then
                _G.HubState.currentAnchorPart.CFrame = finalCFrame
            end

            -- Dịch chuyển toàn bộ Character Model (Tất cả bộ phận, tay, chân, đầu)
            currentChar:PivotTo(finalCFrame)

            for _, part in ipairs(currentChar:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.AssemblyLinearVelocity = Vector3.zero
                    part.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end)

        if _G.HubState.attachDuration > 0 then
            _G.HubState.attachTimerThread = task.delay(_G.HubState.attachDuration, function()
                if _G.HubState.isAttached then
                    _G.HubState.attachTimerThread = nil
                    _G.HubState.isAttached = false
                    _G.HubState.targetModeIndex = 3
                    _G.HubLogic.UpdateAttachment()
                end
            end)
        end
    else
        stopHeartbeatLoop()

        if _G.HubState.originalCFrame then
            char:PivotTo(_G.HubState.originalCFrame)
            _G.HubState.originalCFrame = nil
        end

        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
                part.Anchored = false
            end
        end

        if _G.HubState.currentWeldConstraint then
            _G.HubState.currentWeldConstraint:Destroy()
            _G.HubState.currentWeldConstraint = nil
        end
        if _G.HubState.currentAnchorPart then
            _G.HubState.currentAnchorPart:Destroy()
            _G.HubState.currentAnchorPart = nil
        end
    end
    _G.HubLogic.SyncMiniGuiStates()
end

_G.HubLogic.ToggleVoid = function()
    if _G.HubState.targetModeIndex == 1 and _G.HubState.isAttached then 
        _G.HubState.isAttached = false
        _G.HubState.targetModeIndex = 3
    else 
        _G.HubState.isAttached = true
        _G.HubState.targetModeIndex = 1
        if _G.HubLogic.StopFlying then _G.HubLogic.StopFlying() end
    end
    _G.HubLogic.UpdateAttachment()
end

_G.HubLogic.ToggleKB = function()
    if _G.HubState.targetModeIndex == 2 and _G.HubState.isAttached then 
        _G.HubState.isAttached = false
        _G.HubState.targetModeIndex = 3
    else 
        _G.HubState.isAttached = true
        _G.HubState.targetModeIndex = 2 
        if _G.HubLogic.StopFlying then _G.HubLogic.StopFlying() end
    end
    _G.HubLogic.UpdateAttachment()
end

_G.HubLogic.CheckVoid = function()
    local char = localPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        _G.HubState.recordedVoidY = char.HumanoidRootPart.Position.Y
    else
        _G.HubState.recordedVoidY = workspace.FallenPartsDestroyHeight - 15
    end
end

_G.HubLogic.CheckKillBricks = function()
    _G.HubState.killBricksList = {}
    for _, part in ipairs(workspace:GetDescendants()) do
        if part:IsA("BasePart") then
            local name = string.lower(part.Name)
            local isKB = false
            if string.find(name, "kill") or string.find(name, "lava") or string.find(name, "damage") then
                isKB = true
            else
                for _, child in ipairs(part:GetChildren()) do
                    if child:IsA("TouchTransmitter") or (child:IsA("Script") and string.find(string.lower(child.Name), "kill")) then
                        isKB = true
                        break
                    end
                end
            end
            if isKB then table.insert(_G.HubState.killBricksList, part) end
        end
    end
end

game:GetService("RunService").Heartbeat:Connect(function()
    local char = localPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
        local currentY = char.HumanoidRootPart.Position.Y
        if char.Humanoid.Health > 0 then
            _G.HubState.lastSafeY = currentY
        else
            if _G.HubState.lastSafeY < -20 then 
                _G.HubState.trackedVoidY = _G.HubState.lastSafeY 
            end
        end
    end
end)

localPlayer.CharacterAdded:Connect(function(char)
    char:WaitForChild("HumanoidRootPart")
    task.wait(0.5)
    if _G.HubState.isAttached then _G.HubLogic.UpdateAttachment() end
end)
